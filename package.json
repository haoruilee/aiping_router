{
  "name": "@aiping.cn/model_router",
  "version": "1.2.9",
  "description": "OpenClaw plugin: smart routing between local Ollama models and AIPing cloud (Kimi-K2.5). ~90% requests stay local.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --exclude src/__tests__/e2e.test.ts",
    "test:e2e": "vitest run src/__tests__/e2e.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "model-router",
    "aiping",
    "ollama",
    "kimi",
    "llm-routing",
    "local-model"
  ],
  "author": "AIPing Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/haoruilee/aiping_router"
  },
  "bugs": {
    "url": "https://github.com/haoruilee/aiping_router/issues"
  },
  "homepage": "https://github.com/haoruilee/aiping_router#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
